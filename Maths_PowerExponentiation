class Solution {
    public double myPow(double x, int n) {
        
        long nn = n;

        if(nn < 0)
        {
            x = 1 / x;
            nn = -nn;
        }

        double ans = 1;

        while(nn > 0)
        {
            if(nn % 2 == 1)
            {
                ans = ans * x;
                nn = nn - 1;
            }
            else
            {
                nn = nn / 2;
                x = x * x;
            }
        }

        return ans;
    }
}
