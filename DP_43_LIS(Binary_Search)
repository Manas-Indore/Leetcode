class Solution {

    public int lengthOfLIS(int[] arr) {

        int n = arr.length;

        int[] temp = new int[n];
        int size = 0;

        for (int i = 0; i < n; i++) {

            // If arr[i] is greater, extend LIS
            if (size == 0 || arr[i] > temp[size - 1]) {
                temp[size] = arr[i];
                size++;
            }

            // Otherwise find lower bound
            else {
                int ind = lowerBound(temp, size, arr[i]);
                temp[ind] = arr[i];
            }
        }

        return size;
    }

    // First index where temp[index] >= target
    int lowerBound(int[] temp, int size, int target) {

        int low = 0;
        int high = size - 1;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            if (temp[mid] >= target) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return low;
    }
}
