class Solution {

    long[][] dp;

    long f(int ind, int buy, int[] prices, int n) {

        // Base case
        if (ind == n)
            return 0;

        // Already calculated
        if (dp[ind][buy] != -1)
            return dp[ind][buy];

        long profit;

        if (buy == 1) {
            // Buy stock
            long take = -prices[ind] + f(ind + 1, 0, prices, n);

            // Skip buying
            long notTake = f(ind + 1, 1, prices, n);

            profit = Math.max(take, notTake);
        } 
        else {
            // Sell stock
            long sell = prices[ind] + f(ind + 1, 1, prices, n);

            // Skip selling
            long notSell = f(ind + 1, 0, prices, n);

            profit = Math.max(sell, notSell);
        }

        return dp[ind][buy] = profit;
    }

    public int maxProfit(int[] prices) {

        int n = prices.length;

        dp = new long[n][2];

        for (int i = 0; i < n; i++)
            Arrays.fill(dp[i], -1);

        return (int) f(0, 1, prices, n);
    }
}
