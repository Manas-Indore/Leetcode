class Solution {

    public int cherryPickup(int[][] grid) {
        int r = grid.length;
        int c = grid[0].length;

        // dp[i][j1][j2]
        int[][][] dp = new int[r][c][c];

        // Fill with -1
        for (int i = 0; i < r; i++) {
            for (int j1 = 0; j1 < c; j1++) {
                for (int j2 = 0; j2 < c; j2++) {
                    dp[i][j1][j2] = -1;
                }
            }
        }

        return f(0, 0, c - 1, r, c, grid, dp);
    }

    public int f(int i, int j1, int j2,
                 int r, int c,
                 int[][] grid,
                 int[][][] dp) {

        // Out of bounds
        if (j1 < 0 || j2 < 0 || j1 >= c || j2 >= c) {
            return (int)-1e8;
        }

        // Last row
        if (i == r - 1) {
            if (j1 == j2) {
                return grid[i][j1];
            } else {
                return grid[i][j1] + grid[i][j2];
            }
        }

        // Already calculated
        if (dp[i][j1][j2] != -1) {
            return dp[i][j1][j2];
        }

        int maxi = (int)-1e8;

        // 9 possible movements
        for (int dj1 = -1; dj1 <= 1; dj1++) {

            for (int dj2 = -1; dj2 <= 1; dj2++) {

                int value;

                // Same cell → count only once
                if (j1 == j2) {
                    value = grid[i][j1];
                } else {
                    value = grid[i][j1] + grid[i][j2];
                }

                value += f(
                    i + 1,
                    j1 + dj1,
                    j2 + dj2,
                    r, c, grid, dp
                );

                maxi = Math.max(maxi, value);
            }
        }

        return dp[i][j1][j2] = maxi;
    }
}
