class Solution {
    public int jump(int[] nums) {

        int jumps = 0;
        int l = 0;
        int r = 0;

        while (r < nums.length - 1) {

            int farthest = 0;

            // Check all indices in current range
            for (int i = l; i <= r; i++) {
                farthest = Math.max(farthest, i + nums[i]);
            }

            // Move to the next range
            l = r + 1;
            r = farthest;

            jumps++;
        }

        return jumps;
    }
}
