class Solution {

    public int lengthOfLIS(int[] arr) {

        int n = arr.length;

        int[] dp = new int[n];

        int maxi = 1;

        for (int i = 0; i < n; i++) {

            dp[i] = 1;

            for (int prev = 0; prev < i; prev++) {

                if (arr[prev] < arr[i]) {
                    dp[i] = Math.max(dp[i], 1 + dp[prev]);
                }
            }

            maxi = Math.max(maxi, dp[i]);
        }

        return maxi;
    }
}
