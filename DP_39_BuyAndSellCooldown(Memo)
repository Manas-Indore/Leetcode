class Solution {

    int[][] dp;

    int f(int ind, int buy, int[] prices) {

        // Base case
        if (ind >= prices.length) {
            return 0;
        }

        // Already calculated
        if (dp[ind][buy] != -1) {
            return dp[ind][buy];
        }

        // We can buy
        if (buy == 1) {
            return dp[ind][buy] = Math.max(
                -prices[ind] + f(ind + 1, 0, prices),
                f(ind + 1, 1, prices)
            );
        }

        // We can sell
        return dp[ind][buy] = Math.max(
            prices[ind] + f(ind + 2, 1, prices),  // sell + cooldown
            f(ind + 1, 0, prices)                // don't sell
        );
    }

    public int maxProfit(int[] prices) {

        int n = prices.length;

        dp = new int[n][2];

        for (int i = 0; i < n; i++) {
            dp[i][0] = -1;
            dp[i][1] = -1;
        }

        return f(0, 1, prices);
    }
}
