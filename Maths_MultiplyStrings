
class Solution {
    public String multiply(String num1, String num2) {
        int m = num1.length();
        int n = num2.length();

        int[] ans = new int[m + n];

        for (int i = m - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {
                int a = num1.charAt(i) - '0';
                int b = num2.charAt(j) - '0';

                int mul = a * b + ans[i + j + 1];

                ans[i + j + 1] = mul % 10;
                ans[i + j] += mul / 10;
            }
        }

        String result = "";

        for (int x : ans) {
            if (!(result.isEmpty() && x == 0)) {
                result += x;
            }
        }

        return result.isEmpty() ? "0" : result;
    }
}
