class Solution {
    public void spf(int[] queries) {
        int[] spf = new int[100000 + 1];

        // Initially spf[i] = i
        for (int i = 1; i <= 100000; i++) {
            spf[i] = i;
        }

        // Find Smallest Prime Factor
        for (int i = 2; i * i <= 100000; i++) {
            if (spf[i] == i) {
                for (int j = i * i; j <= 100000; j = j + i) {
                    if (spf[j] == j) {
                        spf[j] = i;
                    }
                }
            }
        }

        // Print prime factors of each query
        for (int i = 0; i < queries.length; i++) {
            int n = queries[i];

            while (n != 1) {
                System.out.print(spf[n] + " ");
                n = n / spf[n];
            }

            System.out.println();
        }
    }
}
