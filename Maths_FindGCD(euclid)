class Solution {
    public int findGCD(int[] nums) {

        int small = nums[0];
        int large = nums[0];

        // Find smallest and largest
        for (int i = 1; i < nums.length; i++) {
            if (nums[i] < small) {
                small = nums[i];
            }

            if (nums[i] > large) {
                large = nums[i];
            }
        }

        // Euclidean Algorithm
        while (small != 0) {
            int rem = large % small;
            large = small;
            small = rem;
        }

        return large;
    }
}
