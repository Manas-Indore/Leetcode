class Solution {

    int[][] dp;

    int f(int i, int j, String s, String t) {

        // t is completely matched
        if (j < 0) return 1;

        // s is exhausted but t is not
        if (i < 0) return 0;

        if (dp[i][j] != -1) {
            return dp[i][j];
        }

        if (s.charAt(i) == t.charAt(j)) {
            // Take + Not Take
            dp[i][j] = f(i - 1, j - 1, s, t)
                      + f(i - 1, j, s, t);
        } 
        else {
            // Cannot take, so skip s[i]
            dp[i][j] = f(i - 1, j, s, t);
        }

        return dp[i][j];
    }

    public int numDistinct(String s, String t) {

        int n = s.length();
        int m = t.length();

        dp = new int[n][m];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                dp[i][j] = -1;
            }
        }

        return f(n - 1, m - 1, s, t);
    }
}
