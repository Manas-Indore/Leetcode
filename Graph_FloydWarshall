class Solution {
    public void shortest_distance(int[][] matrix) {
        
        int n = matrix.length;

        // Convert -1 to infinity
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                
                if (matrix[i][j] == -1) {
                    matrix[i][j] = (int) 1e9;
                }
                
                if (i == j) {
                    matrix[i][j] = 0;
                }
            }
        }

        // Floyd Warshall Algorithm
        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {
                    
                    matrix[i][j] = Math.min(
                        matrix[i][j],
                        matrix[i][k] + matrix[k][j]
                    );
                }
            }
        }

        // Convert infinity back to -1
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                
                if (matrix[i][j] == (int) 1e9) {
                    matrix[i][j] = -1;
                }
            }
        }
    }
}
