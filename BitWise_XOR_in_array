class Solution {
    public int xorOperation(int n, int start) {
        int x = start / 2;

        // XOR of x, x+1, ..., x+n-1
        int ans = xor(x + n - 1) ^ xor(x - 1);

        // Multiply by 2
        ans = ans * 2;

        // If start is odd, every number has last bit 1.
        // XOR of n ones is 1 only when n is odd.
        if (start % 2 == 1 && n % 2 == 1) {
            ans = ans ^ 1;
        }

        return ans;
    }

    int xor(int n) {
        if (n < 0)
            return 0;

        if (n % 4 == 0)
            return n;
        else if (n % 4 == 1)
            return 1;
        else if (n % 4 == 2)
            return n + 1;
        else
            return 0;
    }
}
