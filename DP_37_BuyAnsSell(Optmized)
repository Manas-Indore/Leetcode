class Solution {

    public int maxProfit(int[] prices) {

        int n = prices.length;
        int[][] dp = new int[n + 1][4];

        for (int ind = n - 1; ind >= 0; ind--) {

            // Buy 1
            dp[ind][0] = Math.max(
                -prices[ind] + dp[ind + 1][1],
                dp[ind + 1][0]
            );

            // Sell 1
            dp[ind][1] = Math.max(
                prices[ind] + dp[ind + 1][2],
                dp[ind + 1][1]
            );

            // Buy 2
            dp[ind][2] = Math.max(
                -prices[ind] + dp[ind + 1][3],
                dp[ind + 1][2]
            );

            // Sell 2
            dp[ind][3] = Math.max(
                prices[ind],
                dp[ind + 1][3]
            );
        }

        return dp[0][0];
    }
}
