class Solution {

    int[][] dp;

    int f(int ind, int prevInd, int[] arr) {

        // Base case
        if (ind == arr.length) {
            return 0;
        }

        // Memoization
        if (dp[ind][prevInd + 1] != -1) {
            return dp[ind][prevInd + 1];
        }

        // Not take
        int len = 0 + f(ind + 1, prevInd, arr);

        // Take
        if (prevInd == -1 || arr[ind] > arr[prevInd]) {
            len = Math.max(
                len,
                1 + f(ind + 1, ind, arr)
            );
        }

        return dp[ind][prevInd + 1] = len;
    }

    public int lengthOfLIS(int[] nums) {

        int n = nums.length;

        dp = new int[n][n + 1];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j <= n; j++) {
                dp[i][j] = -1;
            }
        }

        return f(0, -1, nums);
    }
}
