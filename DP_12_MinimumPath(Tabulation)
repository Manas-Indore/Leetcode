class Solution {

    public int getMaxPathSum(int[][] matrix) {

        int n = matrix.length;
        int m = matrix[0].length;

        int[] prev = new int[m];
        int[] curr = new int[m];

        // First row
        for (int j = 0; j < m; j++) {
            prev[j] = matrix[0][j];
        }

        // Remaining rows
        for (int i = 1; i < n; i++) {

            for (int j = 0; j < m; j++) {

                // Up
                int u = matrix[i][j] + prev[j];

                // Left diagonal
                int ld = matrix[i][j];

                if (j - 1 >= 0)
                    ld += prev[j - 1];
                else
                    ld += (int) -1e9;

                // Right diagonal
                int rd = matrix[i][j];

                if (j + 1 < m)
                    rd += prev[j + 1];
                else
                    rd += (int) -1e9;

                curr[j] = Math.max(u, Math.max(ld, rd));
            }

            // Move current row to previous row
            prev = curr.clone();
        }

        // Maximum value in the last row
        int maxi = (int) -1e9;

        for (int j = 0; j < m; j++) {
            maxi = Math.max(maxi, prev[j]);
        }

        return maxi;
    }
}
