class Solution {

    Boolean[][] dp;

    boolean f(int i, int j, String pattern, String text) {

        // Both strings exhausted
        if (i < 0 && j < 0) {
            return true;
        }

        // Pattern exhausted but text remains
        if (i < 0 && j >= 0) {
            return false;
        }

        // Text exhausted but pattern remains
        if (j < 0 && i >= 0) {

            // Remaining pattern must contain only '*'
            for (int k = 0; k <= i; k++) {
                if (pattern.charAt(k) != '*') {
                    return false;
                }
            }

            return true;
        }

        // Already calculated
        if (dp[i][j] != null) {
            return dp[i][j];
        }

        // Characters match OR pattern has '?'
        if (pattern.charAt(i) == text.charAt(j)
                || pattern.charAt(i) == '?') {

            return dp[i][j] = f(i - 1, j - 1, pattern, text);
        }

        // Pattern has '*'
        if (pattern.charAt(i) == '*') {

            // '*' matches one character OR matches zero characters
            return dp[i][j] =
                    f(i, j - 1, pattern, text)
                    || f(i - 1, j, pattern, text);
        }

        // Characters don't match
        return dp[i][j] = false;
    }

    public boolean isMatch(String s, String p) {

        int n = p.length();
        int m = s.length();

        dp = new Boolean[n][m];

        return f(n - 1, m - 1, p, s);
    }
}
