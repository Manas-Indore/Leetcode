class Solution {
    public int smallestIndex(int[] nums) {
        
        for (int i = 0; i < nums.length; i++) {
            int n = nums[i];
            int sum = 0;

            // Extract and sum digits
            while (n > 0) {
                sum += n % 10;
                n = n / 10;
            }

            // Compare digit sum with index
            if (sum == i) {
                return i;
            }
        }

        return -1;
    }
}
