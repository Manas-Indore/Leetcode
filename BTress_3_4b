/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    public int maxLevelSum(TreeNode root) {

        List<List<Integer>> levels = levelOrder(root);

        long maxSum = Long.MIN_VALUE;
        int ansLevel = 1;

        for (int i = 0; i < levels.size(); i++) {

            long sum = 0;

            for (int val : levels.get(i)) {
                sum += val;
            }

            if (sum > maxSum) {
                maxSum = sum;
                ansLevel = i + 1;   // levels are 1-indexed
            }
        }

        return ansLevel;
    }

    public List<List<Integer>> levelOrder(TreeNode root) {

        List<List<Integer>> ans = new ArrayList<>();

        if (root == null)
            return ans;

        Queue<TreeNode> q = new LinkedList<>();

        q.offer(root);
        q.offer(null);   // Level delimiter

        List<Integer> level = new ArrayList<>();

        while (!q.isEmpty()) {

            TreeNode curr = q.poll();

            if (curr == null) {

                ans.add(level);

                if (q.isEmpty())
                    break;

                level = new ArrayList<>();
                q.offer(null);
            }
            else {

                level.add(curr.val);

                if (curr.left != null)
                    q.offer(curr.left);

                if (curr.right != null)
                    q.offer(curr.right);
            }
        }

        return ans;
    }
}
