class Solution {
    public boolean lemonadeChange(int[] bills) {

        int f = 0;   
        int t = 0;   

        for (int i = 0; i < bills.length; i++) {

            if (bills[i] == 5) {
                f++;
            }

            else if (bills[i] == 10) {

                if (f > 0) {
                    f--;
                    t++;
                }
                else {
                    return false;
                }
            }

            else {   // $20

                // Prefer $10 + $5
                if (t > 0 && f > 0) {
                    t--;
                    f--;
                }

                // Otherwise use three $5
                else if (f >= 3) {
                    f = f - 3;
                }

                else {
                    return false;
                }
            }
        }

        return true;
    }
}
