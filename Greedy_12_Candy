class Solution {
    public int candy(int[] ratings) {

        int n = ratings.length;

        if (n == 1)
            return 1;

        int sum = 1;
        int i = 1;

        while (i < n) {

            // Equal ratings
            if (ratings[i] == ratings[i - 1]) {
                sum = sum + 1;
                i++;
                continue;
            }

            // Increasing slope
            int peak = 1;

            while (i < n && ratings[i] > ratings[i - 1]) {
                peak++;
                sum = sum + peak;
                i++;
            }

            // Decreasing slope
            int down = 1;

            while (i < n && ratings[i] < ratings[i - 1]) {
                down++;
                sum = sum + down;
                i++;
            }

            // Peak was counted twice if both
            // increasing and decreasing slopes exist
            if (down > peak) {
                sum = sum + down - peak;
            }
        }

        return sum;
    }
}
