class Solution {
    public int candy(int[] ratings) {

        int n = ratings.length;

        int sum = 1;
        int i = 1;

        while (i < n) {

            // Equal
            if (ratings[i] == ratings[i - 1]) {
                sum=sum+1;
                i++;
                continue;
            }

            // Increasing
            int peak = 1;

            while (i < n && ratings[i] > ratings[i - 1]) {
                peak+=1;
                sum += peak;
                i++;
            }

            // Decreasing
            int down = 1;

            while (i < n && ratings[i] < ratings[i - 1]) {
                sum += down;
                i++;
                down++;
            }

            // Peak may need more candy
            if (down > peak) {
                sum += down - peak;
            }
        }

        return sum;
    }
}
