class Solution {

    int f(int ind, int T, int[] coins, int[][] dp) {

        // Base case
        if (ind == 0) {
            return T % coins[0] == 0 ? 1 : 0;
        }

        // Already calculated
        if (dp[ind][T] != -1) {
            return dp[ind][T];
        }

        // Don't take
        int notTake = f(ind - 1, T, coins, dp);

        // Take
        int take = 0;

        if (coins[ind] <= T) {
            take = f(ind, T - coins[ind], coins, dp);
        }

        return dp[ind][T] = take + notTake;
    }

    public int change(int amount, int[] coins) {

        int n = coins.length;

        int[][] dp = new int[n][amount + 1];

        for (int i = 0; i < n; i++) {
            Arrays.fill(dp[i], -1);
        }

        return f(n - 1, amount, coins, dp);
    }
}
