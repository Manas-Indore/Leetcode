class Solution {
    public int findTheCity(int n, int[][] edges, int distanceThreshold) {

        int[][] dist = new int[n][n];

        // Initialize distances
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (i == j) {
                    dist[i][j] = 0;
                } else {
                    dist[i][j] = Integer.MAX_VALUE;
                }
            }
        }

        // Add edges
        for (int i = 0; i < edges.length; i++) {
            int u = edges[i][0];
            int v = edges[i][1];
            int wt = edges[i][2];

            dist[u][v] = wt;
            dist[v][u] = wt;
        }

        // Floyd Warshall
        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {

                    if (dist[i][k] == Integer.MAX_VALUE ||
                        dist[k][j] == Integer.MAX_VALUE) {
                        continue;
                    }

                    dist[i][j] = Math.min(
                        dist[i][j],
                        dist[i][k] + dist[k][j]
                    );
                }
            }
        }

        int city = -1;
        int minCity = n;

        // Count reachable cities
        for (int i = 0; i < n; i++) {

            int cntCity = 0;

            for (int j = 0; j < n; j++) {

                if (i != j && dist[i][j] <= distanceThreshold) {
                    cntCity++;
                }
            }

            // <= ensures greatest city index in case of tie
            if (cntCity <= minCity) {
                minCity = cntCity;
                city = i;
            }
        }

        return city;
    }
}
