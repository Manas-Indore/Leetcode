class Solution {

    int f(int i, int j, String s, String t, int[][] dp) {

        // Base case
        if (i < 0 || j < 0)
            return 0;

        // Already calculated
        if (dp[i][j] != -1)
            return dp[i][j];

        // Characters match
        if (s.charAt(i) == t.charAt(j)) {
            return dp[i][j] = 1 + f(i - 1, j - 1, s, t, dp);
        }

        // Characters don't match
        return dp[i][j] = Math.max(
            f(i - 1, j, s, t, dp),
            f(i, j - 1, s, t, dp)
        );
    }

    public int longestCommonSubsequence(String s, String t) {

        int n = s.length();
        int m = t.length();

        int[][] dp = new int[n][m];

        // Fill with -1
        for (int i = 0; i < n; i++) {
            Arrays.fill(dp[i], -1);
        }

        return f(n - 1, m - 1, s, t, dp);
    }
}
