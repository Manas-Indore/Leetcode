class Solution {
    public String minWindow(String s, String t) {

        HashMap<Character, Integer> hash = new HashMap<>();

        // Frequency of characters required from t
        for (char ch : t.toCharArray()) {
            hash.put(ch, hash.getOrDefault(ch, 0) + 1);
        }

        int n = s.length();
        int m = t.length();

        int l = 0;
        int r = 0;
        int cnt = 0;

        int minLen = Integer.MAX_VALUE;
        int start = -1;

        while (r < n) {

            char ch = s.charAt(r);

            // Character is useful only if it is required
            if (hash.containsKey(ch)) {
                if (hash.get(ch) > 0) {
                    cnt++;
                }

                hash.put(ch, hash.get(ch) - 1);
            }

            // Window contains all characters of t
            while (cnt == m) {

                if (r - l + 1 < minLen) {
                    minLen = r - l + 1;
                    start = l;
                }

                char leftChar = s.charAt(l);

                if (hash.containsKey(leftChar)) {
                    hash.put(leftChar, hash.get(leftChar) + 1);

                    // We removed a required character
                    if (hash.get(leftChar) > 0) {
                        cnt--;
                    }
                }

                l++;
            }

            r++;
        }

        if (start == -1) {
            return "";
        }

        return s.substring(start, start + minLen);
    }
}
