class Solution {
    public int rob(int[] nums) {
        int n = nums.length;

        if (n == 1) return nums[0];

        int[] temp1 = new int[n - 1];
        int[] temp2 = new int[n - 1];

        // Exclude last house
        for (int i = 0; i < n - 1; i++) {
            temp1[i] = nums[i];
        }

        // Exclude first house
        for (int i = 1; i < n; i++) {
            temp2[i - 1] = nums[i];
        }

        return Math.max(maxSum(temp1), maxSum(temp2));
    }

    int maxSum(int[] nums) {
        int n = nums.length;

        int prev = nums[0];
        int prev2 = 0;

        for (int i = 1; i < n; i++) {
            int take = nums[i];

            if (i > 1) {
                take += prev2;
            }

            int notTake = prev;

            int curr = Math.max(take, notTake);

            prev2 = prev;
            prev = curr;
        }

        return prev;
    }
}
