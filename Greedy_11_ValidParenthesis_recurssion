class Solution {
    public boolean checkValidString(String s) {
        return solve(s, 0, 0);
    }

    public boolean solve(String s, int ind, int cnt) {

        // More ')' than '('
        if (cnt < 0)
            return false;

        // Reached end
        if (ind == s.length()) {
            return cnt == 0;
        }

        // Current character is '('
        if (s.charAt(ind) == '(') {
            return solve(s, ind + 1, cnt + 1);
        }

        // Current character is ')'
        if (s.charAt(ind) == ')') {
            return solve(s, ind + 1, cnt - 1);
        }

        // Current character is '*'
        // '*' can be:
        // 1. '('
        // 2. ')'
        // 3. empty
        return solve(s, ind + 1, cnt + 1)
            || solve(s, ind + 1, cnt - 1)
            || solve(s, ind + 1, cnt);
    }
}
