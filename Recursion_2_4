import java.util.*;

class Solution {

    static void helper(int[][] mat, int r, int c, String path,
                       ArrayList<String> ans, boolean[][] vis) {

        int n = mat.length;

        if (r < 0 || c < 0 || r >= n || c >= n ||
            mat[r][c] == 0 || vis[r][c]) {
            return;
        }

        if (r == n - 1 && c == n - 1) {
            ans.add(path);
            return;
        }

        vis[r][c] = true;

        // D L R U (Lexicographical order)
        helper(mat, r + 1, c, path + "D", ans, vis);
        helper(mat, r, c - 1, path + "L", ans, vis);
        helper(mat, r, c + 1, path + "R", ans, vis);
        helper(mat, r - 1, c, path + "U", ans, vis);

        vis[r][c] = false; // Backtracking
    }

    public ArrayList<String> ratInMaze(int[][] maze) {

        ArrayList<String> ans = new ArrayList<>();

        int n = maze.length;

        if (n == 0 || maze[0][0] == 0)
            return ans;

        boolean[][] vis = new boolean[n][n];

        helper(maze, 0, 0, "", ans, vis);

        return ans;
    }
}
