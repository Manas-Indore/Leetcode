class Solution {

    boolean isCycleDFS(int curr, ArrayList<ArrayList<Integer>> adj,
                       boolean[] vis, boolean[] recPath) {

        vis[curr] = true;
        recPath[curr] = true;

        for (int v : adj.get(curr)) {

            if (!vis[v]) {
                if (isCycleDFS(v, adj, vis, recPath)) {
                    return true;
                }
            }
            else if (recPath[v]) {
                return true;
            }
        }

        recPath[curr] = false;
        return false;
    }

    public boolean isCycle(ArrayList<ArrayList<Integer>> adj) {

        int V = adj.size();

        boolean[] vis = new boolean[V];
        boolean[] recPath = new boolean[V];

        for (int i = 0; i < V; i++) {
            if (!vis[i]) {
                if (isCycleDFS(i, adj, vis, recPath)) {
                    return true;
                }
            }
        }

        return false;
    }
}
