import java.util.Arrays;

class Solution {
    public int findContentChildren(int[] g, int[] s) {

        int n = g.length;
        int m = s.length;

        int l = 0;
        int r = 0;

        Arrays.sort(g);
        Arrays.sort(s);

        while (l < n && r < m) {

            // Current cookie can satisfy current child
            if (g[l] <= s[r]) {
                l++;
            }

            // Move to next cookie
            r++;
        }

        return l;
    }
}
