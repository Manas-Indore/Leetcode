class Solution {

    static class Pair {
        TreeNode node;
        long index;

        Pair(TreeNode node, long index) {
            this.node = node;
            this.index = index;
        }
    }

    public int widthOfBinaryTree(TreeNode root) {
        if (root == null)
            return 0;

        Queue<Pair> q = new LinkedList<>();
        q.offer(new Pair(root, 0));

        int maxWidth = 0;

        while (!q.isEmpty()) {
            int size = q.size();

            long startIdx = q.peek().index;
            long endIdx = startIdx;

            for (int i = 0; i < size; i++) {
                Pair curr = q.poll();
                endIdx = curr.index;

                if (curr.node.left != null) {
                    q.offer(new Pair(curr.node.left, 2 * curr.index + 1));
                }

                if (curr.node.right != null) {
                    q.offer(new Pair(curr.node.right, 2 * curr.index + 2));
                }
            }

            maxWidth = Math.max(maxWidth, (int) (endIdx - startIdx + 1));
        }

        return maxWidth;
    }
}
