class Solution {

    boolean isCycleDFS(int src, boolean[] vis, boolean[] recPath,
                       int[][] prerequisites, Stack<Integer> s) {

        vis[src] = true;
        recPath[src] = true;

        for (int i = 0; i < prerequisites.length; i++) {

            int v = prerequisites[i][0];
            int u = prerequisites[i][1];

            if (src == u) {

                if (!vis[v]) {
                    if (isCycleDFS(v, vis, recPath, prerequisites, s)) {
                        return true;
                    }
                }
                else if (recPath[v]) {
                    return true;
                }
            }
        }

        recPath[src] = false;

        // Push source node into stack after visiting all neighbours
        s.push(src);

        return false;
    }


    void topoOrder(int src, boolean[] vis, Stack<Integer> s,
                   int[][] prerequisites) {

        vis[src] = true;

        for (int i = 0; i < prerequisites.length; i++) {

            int v = prerequisites[i][0];
            int u = prerequisites[i][1];

            if (src == u) {

                if (!vis[v]) {
                    topoOrder(v, vis, s, prerequisites);
                }
            }
        }

        // Add node after all neighbours
        s.push(src);
    }


    public int[] findOrder(int numCourses, int[][] prerequisites) {

        boolean[] vis = new boolean[numCourses];
        boolean[] recPath = new boolean[numCourses];

        // First check for cycle
        for (int i = 0; i < numCourses; i++) {

            if (!vis[i]) {

                if (isCycleDFS(i, vis, recPath, prerequisites,
                               new Stack<Integer>())) {
                    return new int[0];
                }
            }
        }

        // Topological sorted order
        Stack<Integer> s = new Stack<>();
        vis = new boolean[numCourses];

        for (int i = 0; i < numCourses; i++) {

            if (!vis[i]) {
                topoOrder(i, vis, s, prerequisites);
            }
        }

        int[] ans = new int[numCourses];

        int i = 0;

        while (s.size() > 0) {
            ans[i++] = s.pop();
        }

        return ans;
    }
}
