class Solution {

    public int minDistance(String word1, String word2) {

        int n = word1.length();
        int m = word2.length();

        int[] prev = new int[m + 1];
        int[] cur = new int[m + 1];

        // Base case: word1 is empty
        for (int j = 0; j <= m; j++) {
            prev[j] = j;
        }

        for (int i = 1; i <= n; i++) {

            // word2 is empty
            cur[0] = i;

            for (int j = 1; j <= m; j++) {

                if (word1.charAt(i - 1) == word2.charAt(j - 1)) {

                    cur[j] = prev[j - 1];

                } else {

                    cur[j] = 1 + Math.min(
                            prev[j],                  // Delete
                            Math.min(
                                    cur[j - 1],       // Insert
                                    prev[j - 1]       // Replace
                            )
                    );
                }
            }

            // Move current row to previous row
            prev = cur.clone();
        }

        return prev[m];
    }
}
