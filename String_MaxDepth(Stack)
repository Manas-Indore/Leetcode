import java.util.*;

class Solution {
    public int maxDepth(String s) {
        Stack<Integer> st = new Stack<>();
        int ans = 0;

        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == '(')
                st.push(i);
            else if (s.charAt(i) == ')')
                st.pop();

            int sz = st.size();
            ans = Math.max(ans, sz);
        }

        return ans;
    }
}
