class Solution {
    
    public ArrayList<Integer> JobScheduling(Job[] arr, int n) {
        
        // Sort jobs by profit descending
        Arrays.sort(arr, (a, b) -> b.profit - a.profit);
        
        int maxDeadline = -1;
        
        for (int i = 0; i < n; i++) {
            maxDeadline = Math.max(maxDeadline, arr[i].deadline);
        }
        
        int[] hash = new int[maxDeadline + 1];
        Arrays.fill(hash, -1);
        
        int cnt = 0;
        int totalProfit = 0;
        
        for (int i = 0; i < n; i++) {
            
            for (int j = Math.min(maxDeadline, arr[i].deadline); j > 0; j--) {
                
                if (hash[j] == -1) {
                    cnt++;
                    hash[j] = arr[i].id;
                    totalProfit += arr[i].profit;
                    break;
                }
            }
        }
        
        ArrayList<Integer> ans = new ArrayList<>();
        ans.add(cnt);
        ans.add(totalProfit);
        
        return ans;
    }
}
