import java.util.*;

class Solution {
    public int subarraySum(int[] a, int k) {
        int xr = 0;
        Map<Integer, Integer> mp = new HashMap<>();

        mp.put(0, 1);
        int cnt = 0;

        for (int i = 0; i < a.length; i++) {
            xr = xr ^ a[i];

            int x = xr ^ k;
            cnt += mp.getOrDefault(x, 0);

            mp.put(xr, mp.getOrDefault(xr, 0) + 1);
        }

        return cnt;
    }
}
