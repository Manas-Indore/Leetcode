/*
// Definition for a Node.
class Node {
    public int val;
    public Node prev;
    public Node next;
    public Node child;
};
*/

class Solution {

    public Node flatten(Node head) {
        if (head == null)
            return null;

        Node curr = head;

        while (curr != null) {

            if (curr.child != null) {

                Node next = curr.next;

                // Flatten child list recursively
                Node childHead = flatten(curr.child);

                // Connect current with child
                curr.next = childHead;
                childHead.prev = curr;
                curr.child = null;

                // Find tail of flattened child list
                Node tail = childHead;
                while (tail.next != null) {
                    tail = tail.next;
                }

                // Connect tail with original next
                tail.next = next;
                if (next != null) {
                    next.prev = tail;
                }
            }

            curr = curr.next;
        }

        return head;
    }
}
