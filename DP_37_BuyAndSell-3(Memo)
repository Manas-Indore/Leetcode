class Solution {

    int[][][] dp;

    int f(int ind, int buy, int cap, int[] prices, int n) {

        // Base case
        if (ind == n || cap == 0)
            return 0;

        // Already calculated
        if (dp[ind][buy][cap] != -1)
            return dp[ind][buy][cap];

        if (buy == 1) {

            // Buy
            return dp[ind][buy][cap] = Math.max(
                -prices[ind] + f(ind + 1, 0, cap, prices, n),
                f(ind + 1, 1, cap, prices, n)
            );

        } else {

            // Sell
            return dp[ind][buy][cap] = Math.max(
                prices[ind] + f(ind + 1, 1, cap - 1, prices, n),
                f(ind + 1, 0, cap, prices, n)
            );
        }
    }

    public int maxProfit(int[] prices) {

        int n = prices.length;

        dp = new int[n][2][3];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < 2; j++) {
                Arrays.fill(dp[i][j], -1);
            }
        }

        return f(0, 1, 2, prices, n);
    }
}
