class Solution {

    public int findTargetSumWays(int[] nums, int target) {

        int totalSum = 0;

        for (int num : nums) {
            totalSum += num;
        }

        // Impossible cases
        if (totalSum - target < 0 ||
            (totalSum - target) % 2 != 0) {
            return 0;
        }

        int requiredSum = (totalSum - target) / 2;

        return findWays(nums, requiredSum);
    }

    public int findWays(int[] nums, int target) {

        int n = nums.length;

        int[] prev = new int[target + 1];

        // First element
        if (nums[0] == 0) {

            prev[0] = 2;

        } else {

            prev[0] = 1;

            if (nums[0] <= target) {
                prev[nums[0]] = 1;
            }
        }

        // Remaining elements
        for (int ind = 1; ind < n; ind++) {

            int[] cur = new int[target + 1];

            for (int sum = 0; sum <= target; sum++) {

                // Not take
                int notTake = prev[sum];

                // Take
                int take = 0;

                if (nums[ind] <= sum) {
                    take = prev[sum - nums[ind]];
                }

                cur[sum] = notTake + take;
            }

            prev = cur;
        }

        return prev[target];
    }
}
