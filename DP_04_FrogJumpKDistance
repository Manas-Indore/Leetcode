class Solution {
    public int maxJump(int[] stones) {
        int n = stones.length;

        int[] dp = new int[n];

        dp[0] = 0;

        for (int i = 1; i < n; i++) {
            int minSteps = Integer.MAX_VALUE;

            for (int j = 1; j <= 2; j++) {
                if (i - j >= 0) {
                    int jump = Math.abs(stones[i] - stones[i - j]);

                    int maxJump = Math.max(dp[i - j], jump);

                    minSteps = Math.min(minSteps, maxJump);
                }
            }

            dp[i] = minSteps;
        }

        return dp[n - 1];
    }
}
