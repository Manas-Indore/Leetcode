class Solution {

    public String printLCS(String s, String t) {

        int n = s.length();
        int m = t.length();

        // DP table
        int[][] dp = new int[n + 1][m + 1];

        // Build the table
        for (int i = 1; i <= n; i++) {

            for (int j = 1; j <= m; j++) {

                if (s.charAt(i - 1) == t.charAt(j - 1)) {

                    dp[i][j] = 1 + dp[i - 1][j - 1];

                } else {

                    dp[i][j] = Math.max(
                        dp[i - 1][j],
                        dp[i][j - 1]
                    );
                }
            }
        }

        // Length of LCS
        int len = dp[n][m];

        // StringBuilder to construct answer
        StringBuilder ans = new StringBuilder();

        int i = n;
        int j = m;

        // Backtracking
        while (i > 0 && j > 0) {

            if (s.charAt(i - 1) == t.charAt(j - 1)) {

                ans.append(s.charAt(i - 1));

                i--;
                j--;

            } else if (dp[i - 1][j] > dp[i][j - 1]) {

                i--;

            } else {

                j--;
            }
        }

        // We built the string backwards
        return ans.reverse().toString();
    }
}
